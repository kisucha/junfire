# .env.example — JunFire Protection 환경변수 템플릿
# 실제 운영 시 이 파일을 .env 로 복사하고 값을 교체한다
# 주의: .env 파일은 절대 git에 커밋하지 않는다

# ─────────────────────────────────────────
# Database — PostgreSQL 연결 문자열
# 형식: postgresql://사용자:비밀번호@호스트:포트/DB명
# ─────────────────────────────────────────
DATABASE_URL="mysql://user:password@localhost:3306/junfire"

# ─────────────────────────────────────────
# NextAuth — 세션 서명용 시크릿
# 최소 32자 이상 랜덤 문자열 필수
# 생성 명령: openssl rand -base64 32
# ─────────────────────────────────────────
NEXTAUTH_SECRET="your-secret-32-chars-minimum"

# ─────────────────────────────────────────
# 서버 URL — NextAuth 콜백 URL 기반
# 운영 환경에서 실제 도메인으로 교체
# 예시: https://junfire.yourdomain.com
# ─────────────────────────────────────────
NEXTAUTH_URL="http://localhost:9955"

# ─────────────────────────────────────────
# Node.js 환경 (development | production)
# ─────────────────────────────────────────
NODE_ENV="production"

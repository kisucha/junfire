{
  "name": "junfire-protection",
  "version": "0.1.0",
  "private": true,
  "description": "JunFire Protection 업무시간 관리 시스템 — Next.js 14 App Router 기반 풀스택 웹 애플리케이션",
  "scripts": {
    "dev": "next dev -p 9955",
    "build": "next build && node scripts/patch-react-pdf.js",
    "start": "next start -p 9955",
    "postinstall": "node scripts/patch-react-pdf.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^3.4.4",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "next": "^16.2.6",
    "next-auth": "^4.24.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
